BTC_INITIAL_CAPITAL=1000000
TAO_INITIAL_CAPITAL=10000

# rule: long window must be > short window
# good ratio: long_ma ≈ short_ma × 2 ~ 4
BTC_SHORT_WINDOW=120
BTC_LONG_WINDOW=360

# short window: [9, 5, 14]
# long window:  [21, 20, 50]
# [5, 20]: scalping - fast signals, more trades
# [9, 21]: swing - balanced, fewer fake signals
# [14, 50]: trend - slow, very stable trend capture
TAO_SHORT_WINDOW=9
TAO_LONG_WINDOW=21

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=telegram-chat-ids

LOW_WINDOW=50
MID_WINDOW=120
HIGH_WINDOW=300

OWNER_ID=owner-chat-id